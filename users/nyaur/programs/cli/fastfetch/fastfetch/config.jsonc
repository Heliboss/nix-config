{
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/ashes_crea.jpg",
        "height": 22,
        "width": 43,
        "padding": {
            "left": 13,
        },
    },
    "display": {
        "separator": "  ",
    },
    "modules": [
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "title",
        {
            "type": "os",
            "format": "{3}",
            "key": "os    ",
            "keyColor": "33",  // = color3
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "33",
        },
        {
            "type": "host",
            "format": "{5} {2}",
            "key": "host  ",
            "keyColor": "33",
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "uptime",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "format": "{nix-system} (system), {nix-user} (user), {flatpak-user} (flatpak)",
            "key": "pkgs  ",
            "keyColor": "33",  
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "cpu   ",
            "keyColor": "33",
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "33",
        },
        {
            "type": "swap",
            "key": "swap  ",
            "keyColor": "33",
        },
        {
            "type": "disk",
            "format": "{1} / {2} ({3})",
            "key": "disk  ",
            "keyColor": "33",
        },
    ],
}
